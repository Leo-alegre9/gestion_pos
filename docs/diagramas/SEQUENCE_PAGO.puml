@startuml Flujo de Pago - BarPOS
!theme plain
skinparam BackgroundColor #f8f8f8
skinparam DefaultFontSize 11
skinparam SequenceMessageAlign left
skinparam LifeLineBackgroundColor #e8f4f8

actor "Usuario autenticado" as cajero
participant "Interfaz" as browser
participant "PrepararPagoController" as PrepCtrl
participant "PagoController" as PagoCtrl
participant "PrepararPagoService" as PrepSvc
participant "RegistrarPagoService" as RegSvc
participant "ComprobanteService" as CompSvc
participant "PedidoModel" as PedidoM
participant "DetallePedidoModel" as DetalleM
participant "PagoModel" as PagoM
participant "MetodoPagoModel" as MetodoM

== FASE 0: CIERRE DE PEDIDO ==

cajero -> browser: Cierra el pedido #12
browser -> browser: Permanece en /pedidos/detalles/12\nmuestra botón "Registrar pago"

== FASE 1: MOSTRAR FORMULARIO ==

cajero -> browser: Clic en "Registrar pago"
browser -> PrepCtrl: GET /pagos/formulario/12
PrepCtrl -> PrepSvc: preparar(12)

PrepSvc -> PedidoM: getPedidoConDetalles(12)
PedidoM --> PrepSvc: pedido cerrado ✓

PrepSvc -> PagoM: getPagoPorPedido(12)
PagoM --> PrepSvc: sin pago previo ✓

PrepSvc -> DetalleM: getDetallesPorPedido(12)
DetalleM --> PrepSvc: items[]

PrepSvc -> MetodoM: getActivos()
MetodoM --> PrepSvc: metodos[]

PrepSvc --> PrepCtrl: {ok: true, data: {pedido, items, total: $24.50, metodos}}
PrepCtrl -> browser: view('pagos/pagar', datos)

== FASE 2: REGISTRAR PAGO ==

cajero -> browser: Selecciona "Tarjeta" y confirma
browser -> PagoCtrl: POST /pagos/procesar/12  {id_metodo_pago: 2}
PagoCtrl -> RegSvc: registrar(12, 2)

RegSvc -> PedidoM: find(12)
PedidoM --> RegSvc: pedido cerrado ✓

RegSvc -> PagoM: getPagoPorPedido(12)
PagoM --> RegSvc: sin pago previo ✓

RegSvc -> DetalleM: getDetallesPorPedido(12)
DetalleM --> RegSvc: detalles[]
note over RegSvc: total = Σ(subtotales) = $24.50\n(calculado server-side, no del formulario)

RegSvc -> PagoM: validate(registro)
PagoM --> RegSvc: válido ✓

note over RegSvc: transStart()
RegSvc -> PagoM: insert({pedido:12, metodo:2, monto:24.50, fecha})
PagoM --> RegSvc: id_pago = 45
RegSvc -> PedidoM: update(12, {id_estado_pedido: 'pagado'})
note over RegSvc: transComplete()

RegSvc --> PagoCtrl: {ok: true, idPago: 45}
PagoCtrl -> browser: redirect /pagos/comprobante/45

== FASE 3: COMPROBANTE ==

browser -> PagoCtrl: GET /pagos/comprobante/45
PagoCtrl -> CompSvc: obtenerDatos(45)

CompSvc -> PagoM: getPagoConMetodo(45)
PagoM --> CompSvc: pago con método ✓

CompSvc -> DetalleM: getDetallesPorPedido(12)
DetalleM --> CompSvc: items[]

CompSvc -> PedidoM: getPedidoConDetalles(12)
PedidoM --> CompSvc: pedido ✓

CompSvc --> PagoCtrl: {ok: true, pago, pedido, items, total}
PagoCtrl -> browser: view('pagos/recibo', datos)

browser --> cajero: Pago #45 registrado\n$24.50 · Tarjeta · 2026-05-01

@enduml
